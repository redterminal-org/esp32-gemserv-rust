/.vscode
/.embuild
/target

# Local Python virtual environment for LittleFS image creation
.venv-littlefs/

# Generated LittleFS filesystem images
/littlefs.bin
/littlefs-test.bin

# Ignore created config.toml
/config.toml

# Ignores for the LittleFS
/littlefs/*
/littlefs/certs/
# Keep the public Gemini Content versioned
!/littlefs/gemini/
!/littlefs/gemini/**

# Ignore .build directory for LittleFS builds
.build/

# Local TLS certificates and private keys
/certs/
